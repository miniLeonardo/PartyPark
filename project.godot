; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Partypark"
config/description="Lokales 3D-Partyspiel für bis zu 4 Spieler mit Controllern (Windows und Linux/Bazzite)."
config/version="0.7.0"
run/main_scene="res://ui/title_screen/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Log="*res://core/log.gd"
Settings="*res://core/settings.gd"
Sfx="*res://core/audio/sfx.gd"
Fx="*res://core/fx/fx.gd"
Announcer="*res://core/announcer/announcer.gd"
InputRouter="*res://core/input/input_router.gd"
PlayerRoster="*res://core/teams/player_roster.gd"
MinigameRegistry="*res://core/minigame/minigame_registry.gd"
Game="*res://core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
