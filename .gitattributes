# Einheitliche Zeilenenden zwischen Windows und Linux
* text=auto eol=lf

# Windows-spezifische Skripte behalten CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binärdateien (später ggf. auf Git LFS umstellen, siehe docs/DECISIONS.md)
