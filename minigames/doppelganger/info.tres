"special": "Eigene Figur kurz aufblinken (der Wächter sieht es auch!)"
}
solo_goal_text = "Drei Doppelgänger verstecken sich unter den Besuchern. Du hast 3 Schüsse. Triff alle drei oder halte sie 90 Sekunden von den Aufgaben ab. Ein Treffer auf einen Besucher ist ein verschwendeter Schuss."
solo_controls = {
"move": "Fadenkreuz bewegen",
"jump": "Schießen"
}
solo_role_name = "Wächter"
team_role_name = "Doppelgänger"
